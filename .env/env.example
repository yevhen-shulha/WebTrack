# ─── Налаштування Paleo Monitor ────────────────────────────────────────────
# Скопіюйте цей файл у .env і заповніть своїми даними.

# Інтервал перевірки (секунди). 3600 = щогодини. 0 = один раз і вийти (для cron).
CHECK_INTERVAL=3600

# ─── Активні години ────────────────────────────────────────────────────────
# true  = перевіряти лише у вказаному діапазоні годин
# false = перевіряти цілодобово
ACTIVE_HOURS_ENABLED=true

# Від якої години починати (включно). 9 = з 09:00
ACTIVE_HOUR_FROM=7

# До якої години зупинятись (виключно). 20 = до 19:59
ACTIVE_HOUR_TO=21

# Важливо: часовий пояс береться з системного налаштування сервера.
# На GitHub Actions або VPS встановіть: TZ=Europe/Zurich
# Наприклад, у .env: TZ=Europe/Zurich
# Або при запуску: TZ=Europe/Zurich python paleo_monitor.py
TZ=Europe/Zurich

# ─── Email (Gmail) ─────────────────────────────────────────────────────────
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
# App Password: https://myaccount.google.com/apppasswords
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_TO=your_email@gmail.com

# ─── Telegram ──────────────────────────────────────────────────────────────
TELEGRAM_ENABLED=true
# 1. Напишіть @BotFather → /newbot → скопіюйте токен
TELEGRAM_TOKEN=8112479339:AAEQ_NEMXyh8J1F90feFjCG9W9en3kHG7Uc
# 2. Напишіть @userinfobot → скопіюйте ваш id
TELEGRAM_CHAT_ID=332478987
